{
  "name": "dsh-plugin-modelwatch",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH OpenRouter 模型监控插件：新上模型 / 热门周榜 / 变化流水。全程只读 GET，不推外部通知。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": { "default": "./client.js" },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib", "client.js", "cordis.yml", "prototype", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gh-gongjin/dsh-plugin-modelwatch.git"
  },
  "homepage": "https://github.com/gh-gongjin/dsh-plugin-modelwatch#readme",
  "keywords": ["dsh", "dsh-plugin", "openrouter", "model", "monitor"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "cordis.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}
